# Copia este archivo como .env.local y rellena los valores.
# .env.local NUNCA se sube al repositorio.

# Supabase → Project Settings → API (o "Connect" → App Frameworks → Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Dirección pública de la app (en local, http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Enlace a la lista de espera que ve quien no está en la lista de participantes
NEXT_PUBLIC_WAITLIST_URL=
